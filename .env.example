DATABASE_PASSWORD=replace-with-a-long-random-value
FITLIVE_BRIDGE_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# OIDC is optional; leave empty for signed web bridge/device authentication.
OIDC_ISSUER=
OIDC_AUDIENCE=fitlive
