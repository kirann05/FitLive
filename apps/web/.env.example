# Local development. Copy to .env.local; never commit credentials.
AUTH_MODE=google
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
APP_ORIGIN=http://localhost:5173
# Open-weight provider; set URL only after starting the model server.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3.5:4b
# DEMO_KEY is a public, very limited USDA testing credential (30/hour, 50/day).
# Obtain your own free data.gov key before regular use.
USDA_API_KEY=DEMO_KEY
# Optional hosted Java backend; leave both unset for local D1 storage.
JAVA_API_URL=
FITLIVE_BRIDGE_SECRET=

# Hosted coaching: set AI_PROVIDER=huggingface after adding a private token.
# Limited free credits only; do not enable billing for a free-only trial.
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507:nscale
